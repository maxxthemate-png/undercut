# Undercut — production env vars (set these in Render/Railway dashboard; do NOT commit real values).
# Infra (auto-wired by render.yaml from the managed Postgres/Redis):
DATABASE_URL=postgresql://USER:PASS@HOST:5432/undercut
REDIS_URL=redis://HOST:6379/0

# AI
ANTHROPIC_API_KEY=sk-ant-...

# eBay — PRODUCTION keyset (not sandbox)
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_DEV_ID=
EBAY_USER_TOKEN=
EBAY_SANDBOX=false
EBAY_ITEM_ZIP=53202

# eBay OAuth (multi-tenant onboarding) — RuName from your eBay dev app; accept-URL must point at
# https://<api-domain>/api/repricer/oauth/callback
EBAY_RU_NAME=

# App
SECRET_KEY=change-me-to-a-long-random-string
ENVIRONMENT=production
