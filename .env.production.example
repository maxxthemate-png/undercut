# Undercut: production env var NAMES only. Never commit real values.
#
# Production values live at the Render SERVICE level (srv-d8h4mgcvikkc73es12og),
# NOT the undercut-secrets env group. See OPERATIONS.md "Env vars, THE gotcha".
# This file mirrors the fields actually declared in backend/utils/settings.py.

# --- Core ---
ENVIRONMENT=production
DATABASE_URL=

# --- BOOT-REQUIRED IN PRODUCTION ---
# These two, and ONLY these two, are checked by the fail-fast in
# backend/api/main.py lines 22-31. The service refuses to start with
# ENVIRONMENT=production unless both are set. Set them BEFORE flipping
# ENVIRONMENT, or the deploy fails.
SECRET_KEY=         # signs every JWT / eBay OAuth state / reset / unsubscribe token
UNDERCUT_API_KEY=   # cron/data endpoint gate, sent as X-Cron-Key

# --- REQUIRED IN PRODUCTION, BUT NOT CHECKED AT BOOT ---
# A green deploy does NOT prove this is set. Nothing validates it until the
# first seller connects eBay, at which point _fernet() in backend/utils/crypto.py
# (line 20) raises and the OAuth connect step 500s for every seller. Treat a
# missing value here as a silent revenue-path outage, not a config warning.
TOKEN_ENC_KEY=      # Fernet key, encrypts seller eBay OAuth tokens at rest

# --- OPTIONAL ---
# Unset is legal: backend/api/admin_routes.py line 29 falls back to
# UNDERCUT_API_KEY. Setting a distinct value is recommended, because the
# fallback key is wired into every GitHub Action.
ADMIN_KEY=          # /admin founder dashboard and /api/admin/*, sent as X-Admin-Key

# --- AI ---
ANTHROPIC_API_KEY=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_SCALE=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_SCALE_ANNUAL=
# Optional. Overrides the inline one-time Season Pass price built from
# PASS_PRICE / PASS_DAYS / PASS_PLAN in backend/services/billing.py.
# STRIPE_PRICE_SEASON_PASS=

# --- URLs ---
PUBLIC_APP_URL=     # https://undercutpricer.com
PUBLIC_API_URL=     # https://undercut-api.onrender.com, used for unsubscribe links

# --- Feature flags (both TRUE in prod) ---
REPRICER_ENFORCE_PLAN_LIMITS=true
REPRICER_TIER_FREQUENCY=true
DUNNING_GRACE_DAYS=7

# --- Email (SendGrid) ---
SENDGRID_API_KEY=
FROM_EMAIL=         # authenticated domain sender
OPERATOR_EMAIL=     # operator alert inbox

# --- eBay (PRODUCTION keyset, not sandbox) ---
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_DEV_ID=
EBAY_USER_TOKEN=    # operator token, admin selftest only
EBAY_SANDBOX=false
EBAY_RU_NAME=       # OAuth RuName; accept-URL points at https://<api-domain>/api/repricer/oauth/callback
# EBAY_OAUTH_SCOPES= # optional override, sane default in settings.py

# --- CAN-SPAM footer in customer emails ---
OPERATOR_LEGAL_NAME=
OPERATOR_ADDRESS=
