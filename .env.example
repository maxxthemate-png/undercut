# Undercut — local development env (copy to .env at repo root)
# Production env lives at the Render SERVICE level (srv-d8h4mgcvikkc73es12og),
# NOT the env group — see DEPLOY.md. Never commit real values.

# --- Core ---
ENVIRONMENT=development
SECRET_KEY=dev-change-me
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/undercut   # docker-compose Postgres (port 5433)
ANTHROPIC_API_KEY=sk-ant-your-key   # AI pricing advisor (Pro/Scale feature)

# --- Keys / gates (all optional locally; required in prod) ---
# TOKEN_ENC_KEY=            # Fernet key — REQUIRED before ENVIRONMENT=production (see DEPLOY.md ordering!)
# ADMIN_KEY=                # /admin founder dashboard
# UNDERCUT_API_KEY=         # cron endpoints (X-Cron-Key)

# --- Stripe (test keys locally) ---
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_PRICE_STARTER=price_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_SCALE=price_...
# STRIPE_PRICE_STARTER_ANNUAL=price_...
# STRIPE_PRICE_PRO_ANNUAL=price_...
# STRIPE_PRICE_SCALE_ANNUAL=price_...

# --- URLs ---
PUBLIC_APP_URL=http://localhost:3000        # prod: https://undercutpricer.com
# PUBLIC_API_URL=http://localhost:8000      # prod: https://undercut-api.onrender.com (unsubscribe links)

# --- Plan enforcement (both TRUE in prod since 2026-06-24) ---
REPRICER_ENFORCE_PLAN_LIMITS=false
REPRICER_TIER_FREQUENCY=false
# DUNNING_GRACE_DAYS=7

# --- Email (SendGrid) ---
# SENDGRID_API_KEY=SG....
# FROM_EMAIL=hello@undercutpricer.com       # authenticated domain sender
# OPERATOR_EMAIL=you@example.com            # operator alerts

# --- eBay ---
# EBAY_APP_ID=
# EBAY_CERT_ID=
# EBAY_DEV_ID=
# EBAY_USER_TOKEN=                          # operator token: admin selftest only
EBAY_SANDBOX=true                           # prod: false
# EBAY_RU_NAME=                             # OAuth redirect RuName

# --- CAN-SPAM footer ---
# OPERATOR_LEGAL_NAME=Your Company LLC
# OPERATOR_ADDRESS=123 Main St, City, ST
