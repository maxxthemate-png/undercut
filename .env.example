# ============================================================
# ListingArb — Environment Variables
# Copy this to .env and fill in all values
# ============================================================

# --- System ---
AUTONOMY_LEVEL=1          # 1=manual approval, 2=auto-DM, 3=full-auto
ENVIRONMENT=development   # development | production
SECRET_KEY=change-me-to-a-long-random-string

# --- Database (Supabase) ---
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
SUPABASE_URL=https://[PROJECT].supabase.co
SUPABASE_ANON_KEY=your-anon-key

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- AI / LLM ---
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...        # Fallback (optional)

# --- Facebook Automation ---
# Use a dedicated Facebook account — NOT your personal one
FB_EMAIL=your-fb-account@email.com
FB_PASSWORD=your-fb-password
FB_DAILY_DM_LIMIT=15          # Stay conservative. 20 max.
FB_ACCOUNT_2_EMAIL=           # Optional: second account for rotation
FB_ACCOUNT_2_PASSWORD=

# --- Proxy (Required for production) ---
# Bright Data, Oxylabs, or Smartproxy residential proxies
PROXY_URL=http://user:pass@proxy.provider.com:port
PROXY_ENABLED=false            # Set true in production

# --- Notifications ---
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM_NUMBER=+1XXXXXXXXXX
OPERATOR_PHONE=+1XXXXXXXXXX    # Your phone — gets SMS alerts
OPERATOR_EMAIL=you@email.com

# SendGrid for email
SENDGRID_API_KEY=SG....
FROM_EMAIL=alerts@yourdomain.com

# --- eBay Motors API ---
EBAY_APP_ID=your-app-id
EBAY_CERT_ID=your-cert-id
EBAY_DEV_ID=your-dev-id
EBAY_USER_TOKEN=your-user-token

# --- Target Locations (comma-separated city,state pairs) ---
# The scraper will search these areas on Facebook Marketplace
TARGET_LOCATIONS=Milwaukee,WI;Chicago,IL;Madison,WI

# --- Deal Parameters ---
MIN_LISTING_PRICE=10000       # Only target listings above this price
TARGET_CATEGORIES=RV,boat,trailer,classic car,heavy equipment

# --- Rate Limiting ---
DM_COOLDOWN_HOURS=24          # Don't re-DM same seller within this window
MAX_ACTIVE_DEALS=50           # Cap simultaneous active listings

# --- Contract ---
DOCUSIGN_INTEGRATION_KEY=     # Optional: for e-signature
OPERATOR_LEGAL_NAME=Your LLC Name
OPERATOR_ADDRESS=Your Address
